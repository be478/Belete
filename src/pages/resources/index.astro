---
import BaseLayout from '../../layouts/BaseLayout.astro';
const topics=[['Tax Tips','Plain-language information to help you prepare better questions for tax conversations.'],['Small Business Accounting','Practical ideas for keeping financial information useful and organized.'],['Bookkeeping Basics','Foundations for cleaner records and easier reconciliations.'],['IRS Notices','General guidance on how to read correspondence and what to gather before seeking help.']];
---
<BaseLayout title="Resources | BK Accounting and Tax LLC" description="Educational resources from BK Accounting and Tax LLC on taxes, bookkeeping, accounting and IRS notices."><section class="page-hero"><div class="container narrow"><p class="eyebrow">Resources</p><h1>Clear Information Before the Conversation</h1><p class="lead">This resource center is being built to help clients understand common financial topics in plain language. It is general information, not individualized tax or legal advice.</p></div></section><section class="section"><div class="container cards">{topics.map(([t,d])=><article><span class="eyebrow">Coming soon</span><h2>{t}</h2><p>{d}</p></article>)}</div></section></BaseLayout><style>.page-hero{padding:clamp(4rem,8vw,7rem) 0;background:var(--ivory)}.narrow{max-width:820px}.lead{font-size:1.18rem;color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.cards article{padding:2rem;border:1px solid var(--line)}.cards h2{font-size:2rem}.cards p{color:var(--muted)}@media(max-width:650px){.cards{grid-template-columns:1fr}}</style>