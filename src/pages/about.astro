import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About BK Accounting and Tax LLC" description="Learn about BK Accounting and Tax LLC, its human-centered approach, MSc in Accounting & Finance, and 15+ years of transferable professional experience.">
<section class="page-hero"><div class="container narrow"><p class="eyebrow">About BK</p><h1>Accounting Expertise With a Personal Approach</h1><p class="lead">Clients deserve more than forms, numbers, and technical language. They deserve to understand what is happening with their finances.</p></div></section>
<section class="section"><div class="container story"><div><h2>Experience that goes beyond the numbers</h2><p>Belete and Rute bring advanced education, professional experience, and a personal approach to BK Accounting and Tax LLC.</p><p>With an <strong>MSc in Accounting & Finance</strong> and more than <strong>15 years of transferable professional experience</strong>, the firm's approach is shaped by accounting, finance, financial operations, problem-solving, organization, and client service.</p></div><div class="panel"><strong>15+ Years</strong><span>Transferable professional experience</span><hr/><strong>MSc</strong><span>Accounting & Finance</span><hr/><strong>DMV</strong><span>Serving DC, Maryland & Virginia</span></div></div></section>
<section class="section ivory"><div class="container narrow"><p class="eyebrow">How we work</p><h2>We start by understanding the situation.</h2><p>Some clients come to us during tax season. Others need bookkeeping, accounting, payroll support, or help understanding an IRS notice. Whatever brings you to us, our first priority is understanding what is happening and explaining what deserves attention.</p><p>We believe good service means being responsive, communicating clearly, respecting client confidentiality, and helping people make informed decisions.</p><a class="button button-primary" href="/book-consultation">Book a Consultation</a></div></section>
</BaseLayout>
<style>.page-hero{padding:clamp(4rem,8vw,7rem) 0;background:var(--ivory)}.narrow{max-width:820px}.lead{font-size:1.2rem;color:var(--muted)}.story{display:grid;grid-template-columns:1.3fr .7fr;gap:clamp(2rem,7vw,6rem)}.story p{font-size:1.06rem}.panel{border-top:3px solid var(--gold);padding:2rem;background:#fff;box-shadow:0 18px 55px rgba(40,35,25,.07)}.panel strong{display:block;font:700 2rem Georgia,serif}.panel span{color:var(--muted)}.panel hr{border:0;border-top:1px solid var(--line);margin:1.25rem 0}.ivory{background:var(--ivory)}@media(max-width:760px){.story{grid-template-columns:1fr}}</style>