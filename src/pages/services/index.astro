---
import BaseLayout from '../../layouts/BaseLayout.astro';
const services=[['Tax Services','Tax preparation and practical support for individuals and businesses.','/services/tax-services'],['Accounting Services','Clearer financial information for better business decisions.','/services/accounting'],['Bookkeeping','Organized records, reconciliations, cleanup, and ongoing support.','/services/bookkeeping'],['Payroll','Support for keeping payroll processes and records organized.','/services/payroll'],['IRS Representation','Help reviewing IRS correspondence and determining appropriate next steps.','/services/irs-representation']];
---
<BaseLayout title="Accounting and Tax Services | BK Accounting and Tax LLC" description="Explore tax, accounting, bookkeeping, payroll and IRS support from BK Accounting and Tax LLC in the DMV area."><section class="page-hero"><div class="container narrow"><p class="eyebrow">Services</p><h1>Practical Financial Support, Without the Unnecessary Jargon</h1><p class="lead">You do not need to know exactly which service you need. Start with what is happening, and we can help identify the right next step.</p></div></section><section class="section"><div class="container cards">{services.map(([name,text,href])=><a class="card" href={href}><h2>{name}</h2><p>{text}</p><b>Learn more →</b></a>)}</div></section></BaseLayout><style>.page-hero{padding:clamp(4rem,8vw,7rem) 0;background:var(--ivory)}.narrow{max-width:850px}.lead{font-size:1.18rem;color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.card{padding:2rem;border:1px solid var(--line);text-decoration:none}.card:hover{background:var(--ivory)}.card h2{font-size:2rem}.card p{color:var(--muted)}@media(max-width:680px){.cards{grid-template-columns:1fr}}</style>