---
const nav = [
  ['About', '/about'],
  ['Services', '/services'],
  ['Resources', '/resources'],
  ['Contact', '/contact'],
];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="BK Accounting and Tax LLC home">
      <span class="mark">BK</span>
      <span><strong>BK Accounting</strong><small>and Tax LLC</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>

    <a class="button button-primary booking desktop-booking" href="/book-consultation">Book a Consultation</a>

    <details class="mobile-menu">
      <summary aria-label="Open navigation menu">
        <span class="menu-label">Menu</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>
      <div class="mobile-panel">
        <nav aria-label="Mobile navigation">
          {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
        <a class="button button-primary mobile-booking" href="/book-consultation">Book a Consultation</a>
      </div>
    </details>
  </div>
</header>

<style>
.site-header{border-bottom:1px solid var(--line);background:rgba(255,253,248,.97);position:sticky;top:0;z-index:20;backdrop-filter:blur(8px)}
.nav-wrap{min-height:78px;display:flex;align-items:center;gap:2rem;position:relative}
.brand{display:flex;align-items:center;gap:.7rem;text-decoration:none;margin-right:auto}
.mark{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--gold);font-family:Georgia,serif;font-weight:800;color:var(--gold-dark)}
.brand strong,.brand small{display:block;line-height:1.1}.brand small{font-size:.75rem;color:var(--muted);margin-top:.18rem}
.desktop-nav{display:flex;gap:1.5rem}.desktop-nav a{text-decoration:none;font-weight:650;font-size:.94rem}.desktop-nav a:hover{color:var(--gold-dark)}
.mobile-menu{display:none}.mobile-menu summary{list-style:none}.mobile-menu summary::-webkit-details-marker{display:none}
.menu-label{font-weight:750;font-size:.9rem}.menu-icon{display:grid;gap:4px}.menu-icon i{display:block;width:20px;height:2px;background:var(--charcoal)}
@media(max-width:820px){
  .desktop-nav,.desktop-booking{display:none}
  .mobile-menu{display:block}
  .mobile-menu summary{min-width:76px;min-height:44px;display:flex;align-items:center;justify-content:center;gap:.55rem;border:1px solid var(--line);cursor:pointer;background:var(--paper)}
  .mobile-menu summary:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
  .mobile-panel{position:absolute;left:0;right:0;top:78px;background:var(--paper);border:1px solid var(--line);border-top:0;padding:1rem;box-shadow:0 18px 40px rgba(32,32,30,.12)}
  .mobile-panel nav{display:grid}
  .mobile-panel nav a{padding:.9rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;font-weight:700}
  .mobile-booking{width:100%;margin-top:1rem}
  .brand strong{font-size:.9rem}.brand small{font-size:.67rem}
}
@media(max-width:430px){.brand span:last-child{display:none}.nav-wrap{min-height:70px}.mobile-panel{top:70px}}
</style>