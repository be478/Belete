---
const nav = [
  ['About', '/about'],
  ['Services', '/services'],
  ['Resources', '/resources'],
  ['Contact', '/contact'],
];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="BK Accounting and Tax LLC home">
      <span class="mark">BK</span>
      <span><strong>BK Accounting</strong><small>and Tax LLC</small></span>
    </a>
    <nav aria-label="Primary navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="button button-primary booking" href="/book-consultation">Book a Consultation</a>
  </div>
</header>
<style>
.site-header{border-bottom:1px solid var(--line);background:rgba(255,253,248,.96);position:sticky;top:0;z-index:20}.nav-wrap{min-height:78px;display:flex;align-items:center;gap:2rem}.brand{display:flex;align-items:center;gap:.7rem;text-decoration:none;margin-right:auto}.mark{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--gold);font-family:Georgia,serif;font-weight:800;color:var(--gold-dark)}.brand strong,.brand small{display:block;line-height:1.1}.brand small{font-size:.75rem;color:var(--muted);margin-top:.18rem}nav{display:flex;gap:1.5rem}nav a{text-decoration:none;font-weight:650;font-size:.94rem}nav a:hover{color:var(--gold-dark)}@media(max-width:820px){nav{display:none}.booking{font-size:.8rem;padding:.55rem .7rem}.brand strong{font-size:.9rem}.brand small{font-size:.67rem}}
</style>