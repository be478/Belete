---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { title:string; description:string; eyebrow:string; headline:string; intro:string; services:string[]; cta:string; note?:string; }
const { title, description, eyebrow, headline, intro, services, cta, note } = Astro.props;
---
<BaseLayout {title} {description}>
<section class="page-hero"><div class="container narrow"><p class="eyebrow">{eyebrow}</p><h1>{headline}</h1><p class="lead">{intro}</p><a class="button button-primary" href="/book-consultation">{cta}</a></div></section>
<section class="section"><div class="container content-grid"><div><p class="eyebrow">How we can help</p><h2>Practical support, clearly explained</h2><p>We begin by understanding your situation, then help identify the records, questions, and next steps that deserve attention.</p></div><ul>{services.map((item) => <li>{item}</li>)}</ul></div>{note && <div class="container note"><strong>Important:</strong> {note}</div>}</section>
<section class="section ivory"><div class="container narrow"><p class="eyebrow">Start with a conversation</p><h2>Not sure exactly what you need?</h2><p>You do not need to diagnose the problem before contacting us. Tell us what is happening and we will help determine an appropriate next step.</p><a class="button button-primary" href="/contact">Contact BK Accounting and Tax</a></div></section>
</BaseLayout>
<style>.page-hero{padding:clamp(4rem,8vw,7rem) 0;background:var(--ivory)}.narrow{max-width:820px}.lead{font-size:1.18rem;color:var(--muted);margin-bottom:2rem}.content-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,6rem);align-items:start}.content-grid p{font-size:1.06rem}.content-grid ul{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}.content-grid li{padding:1rem 0;border-bottom:1px solid var(--line);font-weight:700}.note{margin-top:2.5rem;padding:1rem 1.2rem;background:var(--ivory);border-left:3px solid var(--gold)}.ivory{background:var(--ivory)}@media(max-width:760px){.content-grid{grid-template-columns:1fr}}</style>